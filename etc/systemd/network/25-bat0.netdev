# Create the batman-adv soft interface. Creating this netdev loads the
# batman-adv module on demand.
#
# RoutingAlgorithm is immutable after creation and MUST match on every node.
# batman-iv is the safe choice: batman-v picks routes by estimated throughput,
# which leans on the S1G driver reporting sane rate info -- not something to
# assume on hardware this new. (networkd defaults to batman-v, so setting this
# explicitly matters.)
#
# GatewayMode=client: the router announces itself as a batman gateway, and this
# marks the node as a consumer of one. Note what this does and does not buy:
# batman's gateway election steers DHCP, and this mesh has none (addressing is
# static, naming is mDNS), so it will NOT install a default route by itself.
# The route comes from Gateway= in 25-bat0.network. What client mode does give
# is `batctl gwl` showing the elected gateway, which is the check that says
# whether the mesh can see the uplink at all -- worth having even though the
# routing is done by hand.

[NetDev]
Name=bat0
Kind=batadv

[BatmanAdvanced]
RoutingAlgorithm=batman-iv
GatewayMode=client
