# L3 + naming for the mesh.
#
# IPv6 ULA only: static, self-derived, no router advertisements and no DHCP.
# mDNS makes <hostname>.local resolvable peer-to-peer across the mesh, so the
# actual address value never has to be typed by a human.
#
# IPv6 ONLY -- there is no IPv4 on this interface, by design. Nothing on the
# mesh can reach an IPv4 literal, so `ping 8.8.8.8` fails here even with the
# uplink perfectly healthy. Use the v6 resolvers; see README.md.
#
# ############################  PER-NODE  ##############################
# Replace the host suffix in Address= below.
#   * The /48 PREFIX (fd12:3456:789a::) MUST be identical on every node.
#     Generate it ONCE at random (RFC 4193) for the whole fleet.
#     A per-node prefix silently splits the fleet into unreachable subnets.
#   * The SUFFIX is unique per node -- derive it EUI-64 style from the radio's
#     permanent MAC so it is deterministic and collision-free.
# #####################################################################

[Match]
Name=bat0

[Network]
# SHARED prefix, PER-NODE suffix
Address=fd12:3456:789a::1/64
IPv6AcceptRA=no
LinkLocalAddressing=ipv6
MulticastDNS=yes
DHCP=no

# The uplink. Stamped by install_network_stack.sh from the roster entry named
# by $GATEWAY_NAME, so it tracks a ULA_PREFIX override instead of drifting from
# it. IPv6AcceptRA=no above means nothing else will ever install a default
# route on this link -- without this line the mesh has no way out, which is
# exactly the "Network is unreachable" that sent us looking.
#
# Not conditional on the router being up: a default route pointing at an absent
# gateway costs nothing, and batman reconverges on its own when it returns.
Gateway=fd12:3456:789a::1

# Resolvers must be reachable over the mesh, i.e. IPv6 and routed through the
# gateway above. The v4 addresses everyone has memorised are useless here.
# Google and Cloudflare respectively; Domains=~. sends non-.local, non-.mesh
# lookups this way rather than to whatever eth0 last advertised.
#
# ~. is a monopoly unless another link claims it too, and on the bench that
# monopoly is a bug: mesh down, Ethernet healthy, every lookup still sent here
# to die with "No route to host". The installer therefore stamps ~. onto the
# NetworkManager Ethernet profiles as well (see install_network_stack.sh), so
# resolved races both scopes and whichever side is reachable answers.
DNS=2001:4860:4860::8888
DNS=2606:4700:4700::1111
# Domains=~.

[Link]
# Assign the address even on a "mesh of one" (no peers yet), rather than
# waiting for carrier that only appears once a neighbour shows up.
ConfigureWithoutCarrier=yes
