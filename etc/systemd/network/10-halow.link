# Rename the Morse Micro S1G radio to a stable, collision-proof name.
# Matches any morse* driver (native and USB variants); "halow0" is outside the
# kernel's own wlan* namespace, so it can never race the kernel for a name.
#
# Sorts before /usr/lib/systemd/network/99-default.link, so this wins.
[Match]
Driver=morse*

[Link]
Name=halow0
