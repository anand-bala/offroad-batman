# Give the Morse HaLow radio a stable name. Install to
# /etc/systemd/network/10-halow.link on every node.
#
# The card is USB, so predictable naming hands it a MAC-derived name like
# wlx0cbf74005bc8 -- different on every node, which makes fleet-wide scripts
# and config impossible to share.
#
# Matching on the driver rather than the MAC is what keeps this file identical
# across all four Jetsons. Confirm the driver name reported for the netdev
# before trusting it:
#
#   ethtool -i <iface> | head -2
#   udevadm info /sys/class/net/<iface> | grep -E 'ID_NET_DRIVER|DRIVERS='
#
# The module is named morse, but the USB driver registers separately as
# morse_usb (morse/morse_driver/usb.c:1212), and that is what udev reports for
# the M.2 card: ID_NET_DRIVER=morse_usb. Driver= takes a whitespace-separated
# list, so both are matched and the same file works on USB, SDIO and SPI nodes.
#
# Install:
#   sudo install -m 0644 10-halow.link /etc/systemd/network/10-halow.link
#   sudo udevadm control --reload
#   sudo update-initramfs -u        # only if morse.ko is pulled into initrd
#   reboot, or unplug/replug the card
#
# Verify:
#   udevadm test-builtin net_setup_link /sys/class/net/<iface>

[Match]
Driver=morse morse_usb

[Link]
# Deliberately not wlan0. systemd warns against renaming into the kernel's own
# namespace (eth*, wlan*), because the kernel may hand that name to another
# device before the rename lands, and the rename then fails intermittently --
# a miserable failure mode on a node you cannot reach. halow0 is outside that
# namespace and cannot collide.
Name=halow0
